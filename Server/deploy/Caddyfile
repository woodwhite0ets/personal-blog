{
	email woodwhite0ets@gmail.com
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

blog.woodwhite.top {
	# 访问日志（含客户端 IP）
	log {
		output file /var/log/caddy/blog-access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}

	# 拦截敏感文件探测（.env / AWS 凭证 / Stripe / git/svn 目录 / 备份文件等），直接 404
	@probe path /*.env* /.aws/* /aws-ses* /.stripe* /stripe* /.git/* /.svn/* /*.DS_Store /test.php /*.bak /*.old /*.backup /*.save /*.local
	respond @probe 404

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
	reverse_proxy 127.0.0.1:3027
}
