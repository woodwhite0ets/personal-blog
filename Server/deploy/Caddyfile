{
	email woodwhite0ets@gmail.com
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

# ==== 复用片段（宏展开，等价于粘贴到站点块） ====
(access_log) {
	log {
		output file {args[0]} {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}

(security) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}

(gw_upstream) {
	reverse_proxy https://127.0.0.1:18081 {
		header_up Host mcp.woodwhite.top
		transport http {
			tls_server_name mcp.woodwhite.top
			tls_insecure_skip_verify
		}
	}
}

(env_probe) {
	@env_probe {
		path *.env* /.aws/* /aws-ses* /.stripe* /stripe* /.ssh/* /.git/* /.svn/* /*.DS_Store /test.php /*.bak /*.old /*.backup /*.save /*.local
		path /wp-config* /wp-admin* /phpinfo* /server-status* /config.json* /docker-compose* /Caddyfile*
	}
}

(wp_probe) {
	@wp_probe {
		path /wp-includes/* /wp-content/* /wp-json/* /xmlrpc* /wlwmanifest*
		path /blog/wp-includes/* /web/wp-includes/* /wordpress/wp-includes/* /wp/wp-includes/*
	}
}

woodwhite.top {
	import access_log /var/log/caddy/woodwhite-access.log
	import security

	import env_probe
	route @env_probe {
		header Server "Apache/2.4.41 (Ubuntu)"
		header Content-Type "text/plain; charset=utf-8"
		rewrite * /.env
		root * /var/www/honeypot
		file_server
	}

	import wp_probe
	route @wp_probe {
		header Server "Apache/2.4.41 (Ubuntu)"
		header Content-Type "application/json"
		rewrite * /troll.json
		root * /var/www/honeypot
		file_server
	}

	reverse_proxy 127.0.0.1:3027
}

blog.woodwhite.top {
	import access_log /var/log/caddy/blog-access.log
	import security

	import env_probe
	handle @env_probe {
		header Server "Apache/2.4.41 (Ubuntu)"
		header Content-Type "text/plain; charset=utf-8"
		rewrite * /.env
		root * /var/www/honeypot
		file_server
	}

	import wp_probe
	handle @wp_probe {
		header Server "Apache/2.4.41 (Ubuntu)"
		header Content-Type "application/json"
		rewrite * /troll.json
		root * /var/www/honeypot
		file_server
	}

	handle_path /api/gateway/* {
		rewrite * /api{uri}
		import gw_upstream
	}

	@gateway_health path /healthz
	handle @gateway_health {
		import gw_upstream
	}

	@gateway_mcp path /mcp /mcp/*
	handle @gateway_mcp {
		import gw_upstream
	}

	@legacy_console path /console /console/*
	redir @legacy_console /gateway 302

	handle {
		reverse_proxy 127.0.0.1:3027
	}
}

mcp.woodwhite.top {
	import access_log /var/log/caddy/mcp-access.log
	import security

	@gateway path /healthz /mcp* /api /api/*
	@blog_api path /api/posts* /api/tags* /api/authors*

	route {
		handle @blog_api {
			reverse_proxy 127.0.0.1:3027 {
				header_up -Origin
				header_down Access-Control-Allow-Origin https://mcp.woodwhite.top
			}
		}
		handle @gateway {
			import gw_upstream
		}
		handle {
			reverse_proxy 127.0.0.1:3027 {
				header_up -Origin
				header_down Access-Control-Allow-Origin https://mcp.woodwhite.top
			}
		}
	}
}

map.woodwhite.top {
	import access_log /var/log/caddy/map-access.log
	import security

	import env_probe
	route @env_probe {
		header Server "Apache/2.4.41 (Ubuntu)"
		respond 200 {
			body file:///var/www/honeypot/.env
		}
	}

	import wp_probe
	route @wp_probe {
		header Server "Apache/2.4.41 (Ubuntu)"
		respond 200 {
			body file:///var/www/honeypot/troll.json
		}
	}

	@feedok path /log-feed/de0780b77b05a3a5b3f7220ca791b31369ef9c4ebaff6d7d
	route @feedok {
		header Cache-Control "no-store"
		rewrite * /snapshot.json
		root * /var/www/logfeed
		file_server
	}
	reverse_proxy 127.0.0.1:13001
}
