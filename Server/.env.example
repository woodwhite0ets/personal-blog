# 环境变量模板 — 复制为 .env 并填入实际值
# 注意: .env 包含敏感信息，不会被提交到 Git

PORT=3027
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的MySQL密码
DB_NAME=blog_byown
# JWT 已改为 RS256：私钥签名（博客）、公钥验签（博客 + 网关）。
# 密钥二选一提供：Server/keys/jwt_private.pem + jwt_public.pem（推荐），或内联 PEM。
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# 仅作 HS256 回滚用，可保留旧值
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 网关权限面板服务账号（一个网关 admin 的 mcp_ token，仅供博客 /admin 代理调用网关管理 API）
GW_ADMIN_TOKEN=
# 博客→网关反向 SSH 隧道（勿改，除非隧道结构变化）
GW_TUNNEL_BASE=https://127.0.0.1:18081
GW_TUNNEL_HOST=mcp.woodwhite.top

# 邮箱配置（以 QQ 邮箱为例，密码用 SMTP 授权码）
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USER=your_email@qq.com
MAIL_PASS=your_smtp_auth_code
MAIL_FROM=your_email@qq.com
SITE_URL=http://localhost:3027
